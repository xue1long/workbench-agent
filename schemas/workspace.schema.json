{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-workbench.local/schemas/workspace.schema.json",
  "title": "Workspace Manifest",
  "description": "Schema for workspace.json. Runtime validation lives in src/workbench.mjs (validateManifest) and core/config/manifest.mjs; this file documents the same shape for external tooling. ajv-backed validation lands in a later milestone.",
  "type": "object",
  "required": ["version", "workspace", "environment"],
  "properties": {
    "version": {
      "type": "string",
      "const": "1",
      "description": "Manifest schema version. Must be the string \"1\"."
    },
    "workspace": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$" },
        "name": { "type": "string" }
      },
      "additionalProperties": true
    },
    "environment": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["version"],
        "properties": {
          "version": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._+\\-:]+$" }
        },
        "additionalProperties": false
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$" },
          "source": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "enum": ["git", "local"] },
              "url": { "type": "string", "minLength": 1 },
              "ref": { "type": "string" }
            },
            "additionalProperties": false
          },
          "branch": { "type": "string" },
          "path": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$" },
          "provider": { "type": "string" },
          "executable": { "type": "string" },
          "capabilities": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$" },
          "version": { "type": "string" },
          "source": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "mcp": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$" },
          "enabled": { "type": "boolean" },
          "transport": { "type": "string", "enum": ["stdio", "http"] },
          "command": { "type": "string" },
          "args": { "type": "array", "items": { "type": "string" } },
          "environment": {
            "type": "object",
            "additionalProperties": { "type": "object" }
          }
        },
        "additionalProperties": true
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$" },
          "type": { "type": "string", "enum": ["skill", "mcp", "workflow", "agent", "project-template", "knowledge-pack", "environment-pack", "workspace-template"] },
          "version": { "type": "string" },
          "source": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "enum": ["github", "git", "local"] },
              "repository": { "type": "string" },
              "url": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "auto_update": { "type": "boolean" },
        "verify_after_apply": { "type": "boolean" },
        "stop_on_failure": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "extensions": {
      "type": "object",
      "additionalProperties": { "type": "object" }
    }
  },
  "additionalProperties": true
}