diff --git a/tests/test_test_command_evidence.py b/tests/test_test_command_evidence.py
new file mode 100644
index 0000000..eae128f
--- /dev/null
+++ b/tests/test_test_command_evidence.py
@@ -0,0 +1,113 @@
+"""Phase 0 Runtime protocol tests: configured ``test_command`` becomes part of
+the trusted evidence chain. A required ``test`` acceptance only ``finish``es
+when the configured command succeeds; a non-zero exit must force a halt.
+
+The command argv is taken from ``RuntimeKernel(test_command=...)``, which
+the protocol CLI populates from ``config/runtime.yaml``. We bypass the
+subprocess spawning here only by injecting argv into the kernel directly.
+"""
+
+from __future__ import annotations
+
+import pathlib
+import sys
+
+from devflow_runtime.domain.action import Action
+from devflow_runtime.domain.intent import Acceptance, IntentDocument
+from devflow_runtime.runtime.kernel import RuntimeKernel
+
+
+def _intent() -> IntentDocument:
+    return IntentDocument(
+        id="intent-tc",
+        version="1.0.0",
+        requirements=["run the configured test command"],
+        acceptances=[Acceptance(id="acc-test", verifier_ref="test", required=True)],
+        constraints=[],
+    )
+
+
+def _action(target: pathlib.Path, action_id: str, state_revision: int) -> Action:
+    return Action(
+        id=action_id,
+        kind="file_edit",
+        actor="agent",
+        target_paths=[str(target)],
+        payload={"edit": {"path": str(target), "patch": "x = 1\n", "expected_digest": ""}},
+        intent_version="1.0.0",
+        policy_version="1.0.0",
+        state_revision=state_revision,
+        idempotency_key=f"ik-{action_id}",
+    )
+
+
+def test_successful_test_command_produces_trusted_test_evidence_and_finishes(
+    tmp_path: pathlib.Path,
+) -> None:
+    """When ``test_command`` exits 0, the test verifier emits trusted evidence
+    and the Decision Engine reaches ``finish``."""
+    workspace = tmp_path / "ws"
+    workspace.mkdir()
+    target = workspace / "a.py"
+    target.write_text("old\n", encoding="utf-8")
+    kernel = RuntimeKernel(
+        workspace_root=workspace,
+        event_store_dir=tmp_path / "es",
+        test_command=[sys.executable, "-c", "print('ok')"],
+    )
+    session = kernel.start(_intent())
+    result = kernel.request_action(session.id, _action(target, "act-ok", session.state_revision))
+
+    assert result.decision.kind == "finish", result.decision
+    # The EventStore must contain a trusted ``test`` evidence event that
+    # records the literal argv and a zero exit code.
+    events = kernel._store().read_all()
+    test_evidence = [
+        e for e in events
+        if e.event_type == "evidence_generated"
+        and e.payload.get("evidence", {}).get("provenance") == "test"
+    ]
+    assert test_evidence, "no test evidence event recorded"
+    last = test_evidence[-1].payload["evidence"]
+    assert last["trusted"] is True
+    assert last["payload"]["exit_code"] == 0
+    assert last["payload"]["command"] == [sys.executable, "-c", "print('ok')"]
+
+
+def test_failing_test_command_blocks_finish_and_records_rejection(
+    tmp_path: pathlib.Path,
+) -> None:
+    """A non-zero exit must produce untrusted test evidence, halt the
+    session, and surface the failure reason in ``blocking_reasons``."""
+    workspace = tmp_path / "ws"
+    workspace.mkdir()
+    target = workspace / "a.py"
+    target.write_text("old\n", encoding="utf-8")
+    kernel = RuntimeKernel(
+        workspace_root=workspace,
+        event_store_dir=tmp_path / "es",
+        test_command=[sys.executable, "-c", "import sys; sys.exit(3)"],
+    )
+    session = kernel.start(_intent())
+    result = kernel.request_action(session.id, _action(target, "act-fail", session.state_revision))
+
+    # finish is forbidden when the configured test command failed.
+    assert result.decision.kind == "halt", result.decision
+    assert "test" in (result.decision.reason or "").lower()
+    state = kernel.status(session.id)
+    assert state.terminal is False
+    # Untrusted test evidence plus an ``action_rejected`` event are required.
+    events = kernel._store().read_all()
+    test_evidence = [
+        e for e in events
+        if e.event_type == "evidence_generated"
+        and e.payload.get("evidence", {}).get("provenance") == "test"
+    ]
+    assert test_evidence[-1].payload["evidence"]["trusted"] is False
+    assert test_evidence[-1].payload["evidence"]["payload"]["exit_code"] == 3
+    rejected = [
+        e for e in events
+        if e.event_type == "action_rejected"
+        and "test" in str(e.payload.get("reason", "")).lower()
+    ]
+    assert rejected, "expected action_rejected event carrying the test failure"
diff --git a/tests/test_two_session_isolation.py b/tests/test_two_session_isolation.py
new file mode 100644
index 0000000..431dcb0
--- /dev/null
+++ b/tests/test_two_session_isolation.py
@@ -0,0 +1,123 @@
+"""Phase 0 Runtime regression: two consecutive sessions in one workspace must
+remain isolated. Session B must not inherit Session A's intent, revision,
+evidence, blocking reasons, or terminal decision.
+
+The Runtime Kernel, the Action Gateway, ``status``, ``recover`` and the
+``observe`` projection all filter on ``aggregate_id == session_id`` before
+reducing events, so a fresh session begins at its own revision with only
+its own facts in scope.
+"""
+
+from __future__ import annotations
+
+import pathlib
+
+from devflow_runtime.domain.action import Action
+from devflow_runtime.domain.intent import Acceptance, IntentDocument
+from devflow_runtime.runtime.kernel import RuntimeKernel
+
+
+def _intent(label: str) -> IntentDocument:
+    return IntentDocument(
+        id=f"intent-{label}",
+        version="1.0.0",
+        requirements=[f"work for {label}"],
+        acceptances=[Acceptance(id=f"acc-{label}", verifier_ref="diff", required=True)],
+        constraints=[],
+    )
+
+
+def _make_action(target: pathlib.Path, action_id: str, state_revision: int) -> Action:
+    return Action(
+        id=action_id,
+        kind="file_edit",
+        actor="agent",
+        target_paths=[str(target)],
+        payload={"edit": {"path": str(target), "patch": "x = 1\n", "expected_digest": ""}},
+        intent_version="1.0.0",
+        policy_version="1.0.0",
+        state_revision=state_revision,
+        idempotency_key=f"ik-{action_id}",
+    )
+
+
+def test_session_b_does_not_inherit_session_a_state(tmp_path: pathlib.Path) -> None:
+    """Session A finishes; Session B must start at its own revision with no
+    inherited evidence, changed paths, or terminal state from Session A."""
+    workspace = tmp_path / "ws"
+    store = tmp_path / "es"
+    kernel = RuntimeKernel(workspace_root=workspace, event_store_dir=store)
+
+    # Session A: complete one accepted action and finish.
+    a = kernel.start(_intent("a"))
+    target_a = workspace / "a.py"
+    target_a.write_text("old\n", encoding="utf-8")
+    result_a = kernel.request_action(a.id, _make_action(target_a, "act-a", a.state_revision))
+    assert result_a.status == "applied"
+    assert result_a.decision.kind == "finish"
+    state_a = kernel.status(a.id)
+    assert state_a.terminal is True
+    assert state_a.changed_paths == [str(target_a)]
+
+    # Session B: must observe its own revision (>=0), empty changed_paths,
+    # no trusted evidence carried over from Session A.
+    b = kernel.start(_intent("b"))
+    assert b.state_revision == 0
+    assert b.intent_id == "intent-b"
+    ctx_b = kernel.observe(b.id)
+    assert ctx_b.intent.id == "intent-b"
+    assert ctx_b.state.revision == 0
+    assert ctx_b.state.changed_paths == []
+    assert ctx_b.state.evidence_ids == []
+    assert ctx_b.state.terminal is False
+    assert ctx_b.state.blocking_reasons == []
+    # Session B's status must not see Session A's terminal state.
+    assert kernel.status(b.id).terminal is False
+    assert kernel.status(b.id).evidence_ids == []
+
+
+def test_session_b_evidence_does_not_leak_into_session_a_status(
+    tmp_path: pathlib.Path,
+) -> None:
+    """Conversely, Session A's status must remain stable after Session B
+    generates new evidence — each session reads only its own event stream.
+    """
+    workspace = tmp_path / "ws"
+    store = tmp_path / "es"
+    kernel = RuntimeKernel(workspace_root=workspace, event_store_dir=store)
+
+    a = kernel.start(_intent("a"))
+    target_a = workspace / "a.py"
+    target_a.write_text("old\n", encoding="utf-8")
+    kernel.request_action(a.id, _make_action(target_a, "act-a", a.state_revision))
+    a_evidence_count = len(kernel.status(a.id).evidence_ids)
+    assert a_evidence_count > 0
+    assert kernel.status(a.id).terminal is True
+
+    b = kernel.start(_intent("b"))
+    target_b = workspace / "b.py"
+    target_b.write_text("old\n", encoding="utf-8")
+    kernel.request_action(b.id, _make_action(target_b, "act-b", b.state_revision))
+
+    # Session A is terminal and its evidence list is unchanged.
+    assert kernel.status(a.id).terminal is True
+    assert kernel.status(a.id).evidence_ids  # still present, untouched
+    assert len(kernel.status(a.id).evidence_ids) == a_evidence_count
+    assert kernel.status(a.id).changed_paths == [str(target_a)]
+
+
+def test_session_a_recover_does_not_see_session_b_journal(tmp_path: pathlib.Path) -> None:
+    """Recovery rebuilds state strictly from the named session's events."""
+    workspace = tmp_path / "ws"
+    store = tmp_path / "es"
+    kernel = RuntimeKernel(workspace_root=workspace, event_store_dir=store)
+
+    a = kernel.start(_intent("a"))
+    b = kernel.start(_intent("b"))
+
+    rec_a = kernel.recover(a.id)
+    rec_b = kernel.recover(b.id)
+    # Two distinct sessions, two distinct recovery results, no cross-talk.
+    assert rec_a.session_id == a.id
+    assert rec_b.session_id == b.id
+    assert rec_a.session_id != rec_b.session_id
